# Copy to .env and fill in.

# Port the API listens on
PORT=4000

# Where the React client is served (for CORS + building join links)
PUBLIC_APP_URL=http://localhost:5173

# --- LiveKit ---
# Must match a key:secret pair in ../livekit.yaml
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_change_me_at_least_32_chars_long
# WS URL the browser uses to reach LiveKit. ws:// for local, wss:// in prod.
LIVEKIT_URL=ws://localhost:7880

# --- Email (Resend) ---
# Optional. If RESEND_API_KEY is empty, invite links are logged to the console
# instead of being emailed — handy for local testing.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend.
# Resend's onboarding sandbox address works for testing: onboarding@resend.dev
MAIL_FROM=onboarding@resend.dev

# Simple shared secret to protect host-only endpoints (create webinar, invite,
# start/stop, moderate). The client sends it as the x-host-key header.
HOST_KEY=change-me-host-key

# --- Reminder worker ---
# Worker loop cadence. 15 means the worker checks every 15 minutes.
REMINDER_INTERVAL_MINUTES=15
# Send reminders this many minutes before webinar start.
REMINDER_LEAD_MINUTES=60
